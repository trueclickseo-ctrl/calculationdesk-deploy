# CalculationDesk Web Server Configuration (Hostinger / Apache / LiteSpeed)
<IfModule mod_rewrite.c>
RewriteEngine On
RewriteBase /

# 1. EXPLICIT 301 REDIRECTS (Applied BEFORE trailing slash normalization or file resolution)
RewriteRule ^guides/how-loan-interest-calculated/?$ /guides/loan-interest-formula-explained/ [R=301,L]

# 2. Existing files or directories served directly
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# 3. Static HTML route mapping
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.*)$ $1.html [L]
</IfModule>
