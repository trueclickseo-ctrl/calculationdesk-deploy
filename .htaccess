# Hostinger / LiteSpeed / Apache Configuration for Next.js Static Export

RewriteEngine On

# Step 1: Real files — force https+www only, no trailing slash logic
RewriteCond %{REQUEST_FILENAME} -f
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} !^www\.calculationdesk\.com$ [NC]
RewriteRule ^(.*)$ https://www.calculationdesk.com/$1 [R=301,L,QSA]
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^ - [L]

# Step 2: Sitemap/robots/verification files — same, no trailing slash logic
RewriteCond %{REQUEST_URI} ^/robots\.txt$ [NC,OR]
RewriteCond %{REQUEST_URI} ^/[a-zA-Z0-9_-]+\.xml$ [NC,OR]
RewriteCond %{REQUEST_URI} ^/yandex_[a-zA-Z0-9]+\.html$ [NC]
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} !^www\.calculationdesk\.com$ [NC]
RewriteRule ^(.*)$ https://www.calculationdesk.com/$1 [R=301,L,QSA]
RewriteCond %{REQUEST_URI} ^/robots\.txt$ [NC,OR]
RewriteCond %{REQUEST_URI} ^/[a-zA-Z0-9_-]+\.xml$ [NC,OR]
RewriteCond %{REQUEST_URI} ^/yandex_[a-zA-Z0-9]+\.html$ [NC]
RewriteRule ^ - [L]

# Step 3: Everything else — single combined check, one redirect regardless of
# how many things are wrong (protocol, host, and/or trailing slash)
# 3a: Ends with a slash (or is root), but host/protocol is wrong -> redirect directly without duplicating slash
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} !^www\.calculationdesk\.com$ [NC]
RewriteCond %{REQUEST_URI} /$
RewriteRule ^(.*)$ https://www.calculationdesk.com/$1 [R=301,L,QSA]

# 3b: Missing trailing slash -> redirect directly, appending slash
RewriteCond %{REQUEST_URI} !(.*)/$
RewriteRule ^(.*)$ https://www.calculationdesk.com/$1/ [R=301,L,QSA]

# Step 4: Route clean URLs to corresponding index.html files if available
RewriteCond %{DOCUMENT_ROOT}/$1/index.html -f
RewriteRule ^(.*)/$ /$1/index.html [L]

RewriteCond %{DOCUMENT_ROOT}/$1.html -f
RewriteRule ^(.*)$ /$1.html [L]

# Custom 404 handler
ErrorDocument 404 /404.html

# Enable Gzip / Deflate Compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript
  AddOutputFilterByType DEFLATE application/javascript application/x-javascript application/json application/xml application/rss+xml
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# Browser Caching Headers for Static Assets
<IfModule mod_expires.c>
  ExpiresActive On
  
  # Cache JavaScript and CSS for 1 year
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType application/x-javascript "access plus 1 year"

  # Cache Fonts & Images for 1 year
  ExpiresByType image/jpg "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/gif "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType font/woff "access plus 1 year"

  # Cache HTML, TXT, XML & JSON for short duration
  ExpiresByType text/html "access plus 1 hour"
  ExpiresByType text/plain "access plus 1 hour"
  ExpiresByType application/xml "access plus 1 hour"
  ExpiresByType application/json "access plus 1 hour"
</IfModule>

# Add Cache-Control Security Headers
<IfModule mod_headers.c>
  <FilesMatch "\.(css|js|woff2|woff|svg|png|jpg|jpeg|gif|ico)$">
    Header set Cache-Control "max-age=31536000, public, immutable"
  </FilesMatch>
  <FilesMatch "\.(html|json|xml|txt)$">
    Header set Cache-Control "max-age=3600, public"
  </FilesMatch>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
</IfModule>
